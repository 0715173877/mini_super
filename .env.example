# Example environment file for MiniSuper.
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored; never commit real credentials.

# --- Django core ---
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
# Accepts: 1/true/yes/on (case-insensitive) or 0/false/no/off
DJANGO_DEBUG=True
# Comma-separated list, e.g. 127.0.0.1,localhost,myhost.example.com
DJANGO_ALLOWED_HOSTS=*

# --- Database (PostgreSQL) ---
# PostgreSQL is used when DB_NAME is set; otherwise the project falls back to SQLite (db.sqlite3).
DB_NAME=minisuper_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
